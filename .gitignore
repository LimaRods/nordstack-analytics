# .venv is a symlink to venv/ so `uv run` finds it. git sees a symlink as a file,
# which the trailing-slash patterns above do not match -- hence this bare entry.
.venv
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

