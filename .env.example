# Copy to .env and adjust as needed:  cp .env.example .env
#
# These are LOCAL DEVELOPMENT defaults for a throwaway Docker stack, not secrets.
# The Postgres values are the ones given in CANDIDATE_BRIEF.md; the MySQL values are
# ours to choose, since the brief only asks that a MySQL source be created.
#
# .env itself is git-ignored. Never commit real credentials.

# --- MySQL: simulated operational billing source -----------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=billing
MYSQL_USER=billing_user
MYSQL_PASSWORD=billing_password
MYSQL_ROOT_PASSWORD=root_password

# --- PostgreSQL: analytics warehouse (dlt raw + dbt) -------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=dbt_user
POSTGRES_PASSWORD=dbt_password

# --- dbt ---------------------------------------------------------------------
# `dev` is the safe default and the only fallback. Production deployment sets
# DBT_TARGET=prod explicitly; see CLAUDE.md section 7.
DBT_TARGET=dev
